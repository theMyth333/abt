# Ollama server base URL. Change if Ollama is running on a different host or port.
OLLAMA_HOST=http://localhost:11434

# Model to use. Must be pulled locally via `ollama pull <model>`.
OLLAMA_MODEL=gemma4:12b

# Context window size passed to Ollama as options.num_ctx.
# Ollama defaults to 4K regardless of model capability; set this explicitly.
# Gemma 4 supports 128K+. Higher values use more VRAM.
HARNESS_NUM_CTX=32768

# Maximum tool-call iterations per user turn before the loop aborts.
HARNESS_MAX_ITER=15

# How many recent messages to always preserve during context trimming.
HARNESS_KEEP_LAST=10
